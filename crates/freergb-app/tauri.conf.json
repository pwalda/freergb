{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freergb",
  "identifier": "dev.freergb.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "freeRGB", "width": 960, "height": 640, "visible": true, "create": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMDE4QTk4QTVGMjMwNDQKUldSRU1QS2xtSW9CY0wrYzM3MitjK0NoV2lrWW5maUZUNEhoTWR4QmF5Tk9MemY2eVJlY1dIRkgK",
      "endpoints": ["https://raw.githubusercontent.com/pwalda/freergb/updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
